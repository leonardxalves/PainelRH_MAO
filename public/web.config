<?xml version="1.0" encoding="UTF-8"?>
<!--
  Painel RH (Manaus) no IIS - mesmo modelo do Portal de XML:
    - o IIS serve a pasta public\ (index.html, scripts.js, styles.css) e os vídeos/imagens de public\videos_mao;
    - /api/* e /health vão para o Node (serviço PainelRH_MAO, http://127.0.0.1:8000).
  Requer URL Rewrite + Application Request Routing (ARR) com o proxy habilitado (o deploy\instalar.ps1 faz isso).
  Se mudar a porta do Node (-PortaNode), troque também o 8000 abaixo.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- API (lista de mídias + eventos SSE) e health: repassa ao Node. -->
        <rule name="API" stopProcessing="true">
          <match url="^(api/.*|health)$" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" appendQueryString="true" />
        </rule>
        <!--
          Mídias: /media/<arquivo> passa a ser servido pelo próprio IIS (arquivo estático em videos_mao),
          que trata Range/206 nativamente. O Node continua gerando a lista com /media/..., nada muda no front.
        -->
        <rule name="Media" stopProcessing="true">
          <match url="^media/(.+)$" />
          <action type="Rewrite" url="videos_mao/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <!-- Nomes de arquivo com "+" (comum em export de vídeo) seriam bloqueados sem isso. -->
      <requestFiltering allowDoubleEscaping="true" />
    </security>

    <staticContent>
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <!-- Front sem cache (não tem hash no nome): depois de alterar, a TV pega na próxima carga. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <!-- Erros do Node chegam como JSON, sem a página de erro do IIS. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>

  <!-- Mídias: a URL já leva ?v=<data de modificação>, então pode ter cache (a TV não baixa o vídeo a cada volta). -->
  <location path="videos_mao">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- SSE: sem compressão dinâmica, senão o IIS segura os eventos. -->
  <location path="api/media/events">
    <system.webServer>
      <urlCompression doDynamicCompression="false" />
    </system.webServer>
  </location>
</configuration>
